#!/bin/bash
# Start a local Hy-MT2 mlx_lm server for omp-translator.
# 7B 8-bit wants 32 GiB+. 7B 4-bit and 1.8B may run with less.
# MLX cap is (RAM − reserve). Loopback only. Pipeline sharding: HYMT2_PIPELINE=1
# Usage: scripts/start-hymt2 [--check]
set -euo pipefail

HOST="${HYMT2_HOST:-127.0.0.1}"
PORT="${HYMT2_PORT:-8080}"
PYTHON="${HYMT2_PYTHON:-python3}"
LOG="${HYMT2_LOG:-$HOME/Library/Logs/hymt2-server.log}"
PIDFILE="${HYMT2_PIDFILE:-${LOG%.log}.pid}"
ROOT="$(cd "$(dirname "$0")" && pwd)"
GiB=$((1024 * 1024 * 1024))

MODEL_7B_8BIT="mlx-community/Hy-MT2-7B-8bit"
MODEL_7B_4BIT="mlx-community/Hy-MT2-7B-4bit"
MODEL_18B_8BIT="mlx-community/Hy-MT2-1.8B-8bit"
MODEL_18B_4BIT="mlx-community/Hy-MT2-1.8B-4bit"

hf_cached() {
	local id="$1"
	local cache="${HF_HOME:-${HOME}/.cache/huggingface}/hub"
	local slug="models--${id//\//--}"
	[ -d "${cache}/${slug}/snapshots" ]
}

min_ram_for() {
	case "$1" in
	*"Hy-MT2-7B-8bit"*) printf '%s\n' $((32 * GiB)) ;;
	*"Hy-MT2-7B-4bit"*) printf '%s\n' $((16 * GiB)) ;;
	*"Hy-MT2-1.8B"*) printf '%s\n' $((8 * GiB)) ;;
	*) printf '%s\n' $((32 * GiB)) ;;
	esac
}

reserve_for() {
	case "$1" in
	*"Hy-MT2-7B-8bit"*) printf '%s\n' $((10 * GiB)) ;;
	*"Hy-MT2-7B-4bit"*) printf '%s\n' $((6 * GiB)) ;;
	*"Hy-MT2-1.8B"*) printf '%s\n' $((2 * GiB)) ;;
	*) printf '%s\n' $((10 * GiB)) ;;
	esac
}

fits_ram() {
	local id="$1" total="$2"
	[ "$total" -ge "$(min_ram_for "$id")" ]
}

macos_ram() {
	if [ "$(uname -s)" != "Darwin" ]; then
		echo "Hy-MT2 local serve is for macOS Apple Silicon." >&2
		exit 1
	fi
	sysctl -n hw.memsize
}

pick_model() {
	local total="$1" id
	if [ -n "${HYMT2_MODEL:-}" ]; then
		if ! fits_ram "$HYMT2_MODEL" "$total"; then
			echo "HYMT2_MODEL=${HYMT2_MODEL} needs more unified memory (sysctl hw.memsize)." >&2
			exit 1
		fi
		printf '%s\n' "$HYMT2_MODEL"
		return
	fi
	local candidates=()
	fits_ram "$MODEL_7B_8BIT" "$total" && candidates+=("$MODEL_7B_8BIT")
	fits_ram "$MODEL_7B_4BIT" "$total" && candidates+=("$MODEL_7B_4BIT")
	fits_ram "$MODEL_18B_8BIT" "$total" && candidates+=("$MODEL_18B_8BIT")
	fits_ram "$MODEL_18B_4BIT" "$total" && candidates+=("$MODEL_18B_4BIT")
	if [ "${#candidates[@]}" -eq 0 ]; then
		echo "Not enough unified memory for Hy-MT2 (7B 8-bit needs 32 GiB; 7B 4-bit 16 GiB; 1.8B 8 GiB)." >&2
		exit 1
	fi
	for id in "${candidates[@]}"; do
		if hf_cached "$id"; then
			printf '%s\n' "$id"
			return
		fi
	done
	printf '%s\n' "${candidates[0]}"
}

model_up() {
	local model="$1"
	curl -s --max-time 5 "http://${HOST}:${PORT}/v1/models" | grep -q '"id"[[:space:]]*:[[:space:]]*"'"$model"'"'
}

TOTAL_RAM="$(macos_ram)"
MODEL="$(pick_model "$TOTAL_RAM")"
MIN_RAM="$(min_ram_for "$MODEL")"
RESERVE="$(reserve_for "$MODEL")"
export HYMT2_TOTAL_RAM="$TOTAL_RAM"
export HYMT2_MIN_RAM="$MIN_RAM"
export HYMT2_RESERVE_BYTES="$RESERVE"

if [ "${1:-}" = "--check" ]; then
	command -v "$PYTHON" >/dev/null || {
		echo "missing python: $PYTHON" >&2
		exit 1
	}
	"$PYTHON" -c "import mlx.core, mlx_lm" >/dev/null
	echo "ok: model=${MODEL} ram_ok=1 min=$((MIN_RAM / GiB))GiB reserve=$((RESERVE / GiB))GiB pipeline=${HYMT2_PIPELINE:-0}"
	exit 0
fi

if model_up "$MODEL" 2>/dev/null; then
	echo "already running: ${MODEL} on loopback"
	exit 0
fi

if lsof -iTCP:"${PORT}" -sTCP:LISTEN >/dev/null 2>&1; then
	echo "port ${PORT} is busy but not serving ${MODEL}" >&2
	exit 1
fi

command -v "$PYTHON" >/dev/null || {
	echo "missing python: $PYTHON" >&2
	exit 1
}
"$PYTHON" -c "import mlx.core, mlx_lm" >/dev/null || {
	echo "python is missing mlx / mlx_lm" >&2
	exit 1
}

mkdir -p "$(dirname "$LOG")"
echo "starting ${MODEL} (log: ${LOG})"

args=(--model "$MODEL" --host "$HOST" --port "$PORT" --decode-concurrency 4 --prompt-concurrency 2 --prompt-cache-size 8 --prompt-cache-bytes 2147483648)
if [ "${HYMT2_PIPELINE:-0}" = "1" ]; then
	args+=(--pipeline)
fi

nohup env HYMT2_TOTAL_RAM="$TOTAL_RAM" HYMT2_MIN_RAM="$MIN_RAM" HYMT2_RESERVE_BYTES="$RESERVE" \
	"$PYTHON" "$ROOT/hymt2_serve.py" "${args[@]}" >>"$LOG" 2>&1 &
echo $! >"$PIDFILE"

for _ in $(seq 1 150); do
	if model_up "$MODEL" 2>/dev/null; then
		echo "ready: ${MODEL} on loopback"
		exit 0
	fi
	sleep 2
done
echo "timed out waiting for the server; see ${LOG}" >&2
exit 1
